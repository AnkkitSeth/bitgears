# Ignore node_modules in both frontend and backend
node_modules/
frontend/node_modules/
backend/node_modules/

# Ignore environment files
.env
.env.local
.env.*.local

# Ignore build outputs (but NOT backend/build for deployment)
/build/
dist/
frontend/build/
# ⚠️ Don't ignore backend/build since we need it for deployment
# backend/build/   <-- Make sure this is REMOVED or COMMENTED

# Logs
*.log
logs/

# System files
.DS_Store

# VSCode settings
.vscode/
